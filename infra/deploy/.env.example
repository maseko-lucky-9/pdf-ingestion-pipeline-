# Copy to .env on the host (chmod 600, root-owned) and fill in.
# NEVER commit the real .env. The example file (this one) is committed; the
# real values land via secure copy at provisioning time.

# Anthropic API key (required) — payload synthesis uses Claude.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional override for the answer model (default claude-3-5-sonnet-latest).
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional override for the judge model used by scripts/run_judge_calibration.py.
# ANTHROPIC_JUDGE_MODEL=claude-3-5-haiku-latest

# Cloudflare Tunnel token — produced by `cloudflared tunnel token <UUID>`.
TUNNEL_TOKEN=REPLACE_ME

# CORS — narrow to the Cloudflare Access hostname to disable credential-bearing
# wildcard CORS. Multiple origins separated by commas.
CORS_ORIGINS=https://rag.prudentiadigital.co.za
