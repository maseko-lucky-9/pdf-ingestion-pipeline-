# Copy to .env and fill in real values. .env is gitignored.

# Required for the answer layer (src/answer.py).
ANTHROPIC_API_KEY=

# Optional — overrides the default model (claude-3-5-sonnet-latest).
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Optional — override the collections root (default: ./collections).
# COLLECTIONS_DIR=/path/to/collections

# Optional — comma-separated CORS origins for the API (default: *).
# CORS_ORIGINS=https://prudentiadigital.co.za,http://localhost:5173

# Optional — JSON or console log format (default: json).
# LOG_FORMAT=console
# LOG_LEVEL=INFO

# Phase 3 slice 2 (deferred): auth-gating for the public RAG endpoint.
# AHF_RAG_AUTH_TOKEN=
